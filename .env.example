# MongoDB Atlas connection string (replace user, password, and cluster host)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/uum_app?retryWrites=true&w=majority

# Secret for signing JWTs (use a long random string in production)
JWT_SECRET=your-super-secret-key-change-this

# Optional: only needed for local dev if you use a custom port (Render sets PORT automatically)
# PORT=3000
